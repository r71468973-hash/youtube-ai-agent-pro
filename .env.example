# Required in production
ADMIN_PASSWORD=change-me-to-a-long-password
APP_SECRET=replace-with-64-random-hex-chars   # openssl rand -hex 32
BASE_URL=http://localhost:3000                # public https URL when deployed
PORT=3000
DATA_DIR=./data

# Optional: API keys can also be entered (encrypted) in the dashboard Settings page.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# ELEVENLABS_API_KEY=
# GOOGLE_TTS_API_KEY=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Optional tuning
# ANTHROPIC_MODEL=claude-sonnet-5-5
# SUBTITLE_FONT_HI=Noto Sans Devanagari
